# Portable make only: no GNU-make conditionals, no $(shell), and no -W*
# overrides, each of which costs a CRAN rejection or a GNU make requirement.
#
# The defines are tools/vendor/manifest.tsv's, which tools/vendor/verify
# checks: NO_GETENV stops libjpeg-turbo's memory manager reading the
# environment; NDEBUG compiles libwebp's assert()s out (an assert links
# abort(), which R packages may not call); and WEBP_EXTERN=extern stops
# libwebp and sharpyuv marking their API visibility("default"), which would
# override $(C_VISIBILITY) and export it from zupix.so.
#
# jpeg-config/ holds the configuration headers CMake would generate for
# libjpeg-turbo; vendor/libwebp is on the path because libwebp includes its
# own headers as "src/dsp/dsp.h" from its root.
PKG_CPPFLAGS = -Ijpeg-config -Ivendor/libjpeg-turbo -Ivendor/libwebp \
	-DNO_GETENV -DNDEBUG -DWEBP_EXTERN=extern
PKG_CFLAGS = $(C_VISIBILITY)
PKG_LIBS = -lz

